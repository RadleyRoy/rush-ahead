/*
 * Rush Ahead's look for every screen: sleek and sporty. Dark smoky glass, hairline edges, small corners, condensed
 * uppercase type (Barlow Condensed; Barlow for reading), white text, one hot accent for what matters. Buttons are
 * slanted, drawn by Ui.Slant from the --fill, --edge and --slant properties below (their own background stays clear).
 * The panel scales to a 1920x1080 reference matched on height, so on a phone 1 px here is about 0.4 dp: touch targets
 * stay at 110 px or more, body text at 34 px or more.
 */

:root {
    --accent: #FF6A2B;
    --accent-hot: #FF8A55;
    --accent-dark: #DE4D14;
    --sun: #FF6A2B;
    --ink: #0B0D10;
    --panel: rgba(12, 14, 18, 0.76);
    --panel-light: rgba(255, 255, 255, 0.07);
    --line: rgba(255, 255, 255, 0.14);
    --text: #F4F6F8;
    --muted: #9AA3AE;
    --good: #3DDC84;
    --bad: #FF4D4D;
    --red: #FF4D4D;
    --blue: #3D9BFF;
    -unity-font-definition: url("project://database/Assets/_Project/ThirdParty/Fonts/Barlow-Medium.ttf");
    -unity-font-style: normal;
    color: var(--text);
}

/* Layers */

.layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.screen {
    flex-grow: 1;
    padding: 36px 48px;
}

.scrim {
    background-color: rgba(5, 6, 8, 0.62);
}

/* Type: condensed and uppercase for anything you glance at, plain Barlow for reading. */

.wordmark, .h1, .h2, .h3, .chip, .btn, .segment, .byline {
    -unity-font-definition: url("project://database/Assets/_Project/ThirdParty/Fonts/BarlowCondensed-Bold.ttf");
}

.wordmark {
    font-size: 176px;
    color: var(--text);
    letter-spacing: 6px;
    -unity-font-style: italic;
    text-shadow: 0 6px 24px rgba(0, 0, 0, 0.55);
}

.byline {
    font-size: 40px;
    color: var(--accent);
    letter-spacing: 10px;
    -unity-font-definition: url("project://database/Assets/_Project/ThirdParty/Fonts/BarlowCondensed-SemiBold.ttf");
}

.h1 {
    font-size: 78px;
    color: var(--text);
    letter-spacing: 2px;
}

.h2 {
    font-size: 54px;
    color: var(--text);
    letter-spacing: 1px;
}

.h3 {
    font-size: 42px;
    color: var(--text);
}

.body {
    font-size: 36px;
    color: var(--text);
    white-space: normal;
}

.muted {
    color: var(--muted);
}

.small {
    font-size: 30px;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/_Project/ThirdParty/Fonts/Barlow-Regular.ttf");
    letter-spacing: 1px;
}

.good { color: var(--good); }
.bad { color: var(--bad); }
.sun { color: var(--accent); }
.team-red { color: var(--red); }
.team-blue { color: var(--blue); }
.team-green { color: #5BE07A; }
.team-yellow { color: #FFD24D; }

/* Layout helpers (UI Toolkit has no gap: spacing comes from margins) */

.row {
    flex-direction: row;
    align-items: center;
}

.col {
    flex-direction: column;
}

.grow {
    flex-grow: 1;
}

.center {
    align-items: center;
    justify-content: center;
}

.spacer-s { height: 12px; width: 12px; }
.spacer { height: 24px; width: 24px; }
.spacer-l { height: 48px; width: 48px; }

/* Panels and cards: smoky glass with a hairline edge; a selected card gets an accent bar down its left. */

.panel {
    background-color: var(--panel);
    border-radius: 6px;
    padding: 34px 40px;
    border-width: 1px;
    border-color: var(--line);
}

.card {
    background-color: var(--panel-light);
    border-radius: 4px;
    padding: 22px 28px;
    margin-bottom: 12px;
    border-left-width: 4px;
    border-left-color: rgba(0, 0, 0, 0);
}

.card--selected {
    border-left-color: var(--accent);
    background-color: rgba(255, 106, 43, 0.12);
}

/* A seat in the lobby: one compact row per animal. */
.seat {
    padding: 12px 22px;
    margin-bottom: 8px;
}

.ellipsis {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.chip {
    background-color: var(--panel);
    border-radius: 3px;
    border-width: 1px;
    border-color: var(--line);
    padding: 8px 22px;
    font-size: 32px;
    letter-spacing: 2px;
    margin-right: 12px;
}

/* Buttons: slanted, uppercase. The shape is painted from --fill and --edge; the box itself stays clear. */

.btn {
    height: 116px;
    min-width: 240px;
    padding: 0 56px;
    margin: 0 0 16px 0;
    border-radius: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--text);
    font-size: 46px;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    flex-shrink: 0;
    --fill: rgba(16, 19, 24, 0.86);
    --edge: rgba(255, 255, 255, 0.22);
    --slant: 0.24;
    transition-property: scale;
    transition-duration: 0.08s;
}

.btn:hover {
    --fill: rgba(32, 37, 46, 0.92);
    --edge: rgba(255, 255, 255, 0.4);
}

.btn:active {
    scale: 0.97 0.97;
    --fill: rgba(44, 50, 60, 0.95);
}

.panel .btn, .card .btn {
    --fill: rgba(255, 255, 255, 0.08);
}

.panel .btn:hover, .card .btn:hover {
    --fill: rgba(255, 255, 255, 0.15);
}

.btn--primary, .panel .btn--primary, .card .btn--primary {
    color: var(--ink);
    --fill: #FF6A2B;
    --edge: rgba(0, 0, 0, 0);
}

.btn--primary:hover, .panel .btn--primary:hover {
    --fill: #FF8A55;
}

.btn--primary:active, .panel .btn--primary:active {
    --fill: #DE4D14;
}

.btn:disabled {
    opacity: 0.35;
}

.btn--danger, .panel .btn--danger {
    --fill: rgba(255, 77, 77, 0.9);
    --edge: rgba(0, 0, 0, 0);
}

.btn--small {
    height: 92px;
    min-width: 0;
    padding: 0 40px;
    font-size: 36px;
    margin: 0 14px 0 0;
}

.btn--icon {
    width: 108px;
    height: 108px;
    min-width: 0;
    padding: 0;
    font-size: 48px;
    margin: 0;
    --slant: 0;
}

.btn--on, .panel .btn--on, .card .btn--on {
    color: var(--ink);
    --fill: #FF6A2B;
    --edge: rgba(0, 0, 0, 0);
}

/* A round button (Burst, with its air gauge): plain glass, no slant. */
.btn--round {
    background-color: rgba(12, 14, 18, 0.72);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.28);
}

/* Segmented choice (Co-op | Team Race, 1 2 3 4, Off Clumsy Keen Ace): tabs, the chosen one underlined. */

.segmented {
    flex-direction: row;
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0);
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
    padding: 0;
    align-self: flex-start;
}

.segment {
    white-space: nowrap;
    flex-shrink: 0;
    height: 92px;
    min-width: 96px;
    padding: 0 30px;
    margin: 0;
    border-radius: 0;
    border-width: 0;
    border-bottom-width: 5px;
    border-bottom-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    color: var(--muted);
    font-size: 38px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

.segment:hover {
    color: var(--text);
}

.segmented--tight .segment {
    min-width: 0;
    padding: 0 17px;
}

.segment--on {
    color: var(--text);
    border-bottom-color: var(--accent);
}

.segment:disabled {
    opacity: 0.35;
}

/* Results: a cell per checkpoint split */

.split {
    background-color: var(--panel-light);
    border-left-width: 3px;
    border-left-color: var(--line);
    padding: 6px 14px 8px 12px;
    margin: 0 8px 8px 0;
}

.split-name {
    -unity-font-definition: url("project://database/Assets/_Project/ThirdParty/Fonts/BarlowCondensed-SemiBold.ttf");
    font-size: 26px;
    letter-spacing: 2px;
    color: var(--muted);
}

.split-time {
    -unity-font-definition: url("project://database/Assets/_Project/ThirdParty/Fonts/BarlowCondensed-Bold.ttf");
    font-size: 36px;
    color: var(--text);
}

.split-delta {
    -unity-font-definition: url("project://database/Assets/_Project/ThirdParty/Fonts/BarlowCondensed-SemiBold.ttf");
    font-size: 28px;
    color: var(--muted);
}

.splits--compact .split {
    padding: 6px 9px 8px 8px;
    margin: 0 6px 8px 0;
}

.splits--compact .split-time { font-size: 31px; }
.splits--compact .split-delta { font-size: 25px; }

.split-delta.good { color: var(--good); }
.split-delta.bad { color: var(--bad); }

/* Text fields */

.field {
    height: 100px;
    margin: 0 0 16px 0;
    font-size: 42px;
}

.field > .unity-text-field__input {
    background-color: rgba(255, 255, 255, 0.07);
    color: var(--text);
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--line);
    padding: 0 26px;
    -unity-text-align: middle-left;
}

/* Banner, toast and confirm */

.banner {
    position: absolute;
    top: 28px;
    left: 25%;
    right: 25%;
    background-color: rgba(222, 52, 52, 0.95);
    border-radius: 4px;
    padding: 16px 24px 16px 32px;
    flex-direction: row;
    align-items: center;
}

.toast {
    position: absolute;
    bottom: 200px;
    left: 30%;
    right: 30%;
    background-color: rgba(12, 14, 18, 0.92);
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--line);
    padding: 18px 28px;
    -unity-text-align: middle-center;
    font-size: 36px;
    white-space: normal;
}

.dialog {
    width: 980px;
    align-self: center;
}

/* Scrolling lists */

/* The Field Guide: a grid of photographed tiles on the left, the page on the right. */

.guide {
    width: 96%;
    height: 94%;
    padding: 30px 36px;
    align-items: stretch;
}

.guide-grid {
    flex-wrap: wrap;
    align-items: flex-start;
}

.guide-tile {
    width: 236px;
    margin: 0 12px 12px 0;
    padding: 6px;
    border-radius: 4px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    background-color: var(--panel-light);
}

.guide-tile:hover {
    border-color: var(--line);
}

.guide-tile--on, .guide-tile--on:hover {
    border-color: var(--accent);
    background-color: rgba(255, 106, 43, 0.14);
}

.guide-tile--unmet .guide-thumb {
    opacity: 0.55;
}

.guide-thumb {
    height: 126px;
    border-radius: 3px;
    background-color: #1A3F55;
    overflow: hidden;
}

.guide-name {
    font-size: 28px;
    margin-top: 6px;
    letter-spacing: 1px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-font-definition: url("project://database/Assets/_Project/ThirdParty/Fonts/BarlowCondensed-SemiBold.ttf");
}

.guide-unmet {
    position: absolute;
    top: 6px;
    left: 6px;
    font-size: 21px;
    padding: 1px 8px;
    letter-spacing: 2px;
    color: var(--ink);
    background-color: var(--accent);
    border-radius: 2px;
    -unity-font-definition: url("project://database/Assets/_Project/ThirdParty/Fonts/BarlowCondensed-Bold.ttf");
}

.guide-picture {
    height: 410px;
    border-radius: 4px;
    background-color: #1A3F55;
    overflow: hidden;
}

.guide-initial {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    font-size: 80px;
    color: rgba(255, 255, 255, 0.35);
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/_Project/ThirdParty/Fonts/BarlowCondensed-Bold.ttf");
}

.guide-counter {
    color: var(--ink);
    background-color: var(--accent);
    border-width: 0;
    margin-right: 0;
}

/* The race's look-out: what's coming next, and a card for something new. */

.ahead {
    flex-direction: row;
    align-items: center;
    padding: 10px 22px 10px 10px;
}

.ahead-picture {
    width: 176px;
    height: 99px;
    margin-right: 18px;
    border-radius: 3px;
    background-color: #1A3F55;
    overflow: hidden;
}

.ahead-name {
    font-size: 36px;
    letter-spacing: 1px;
    -unity-font-definition: url("project://database/Assets/_Project/ThirdParty/Fonts/BarlowCondensed-Bold.ttf");
}

.ahead-counter {
    font-size: 30px;
    letter-spacing: 3px;
    color: var(--accent);
    -unity-font-definition: url("project://database/Assets/_Project/ThirdParty/Fonts/BarlowCondensed-Bold.ttf");
}

.ahead-counter--now {
    color: var(--bad);
}

.ahead-card {
    width: 520px;
    padding: 20px 26px;
    border-left-width: 4px;
    border-left-color: var(--accent);
}

.ahead-card-picture {
    height: 262px;
    margin: 10px 0 12px 0;
    border-radius: 3px;
    background-color: #1A3F55;
    overflow: hidden;
}

.scroll {
    flex-grow: 1;
}

.scroll .unity-scroller--vertical {
    width: 8px;
    opacity: 0.35;
}
